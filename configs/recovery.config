# Minimal offline migration/TFTP environment. No proxy engines or web UI.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# No runtime repositories are published for these custom source feeds.
# CONFIG_FEED_passwall_packages is not set
# CONFIG_FEED_passwall2 is not set
# CONFIG_FEED_mosdns is not set
