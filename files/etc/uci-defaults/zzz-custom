#!/bin/sh
# OpenWrt uses BusyBox ash; local variables follow the dash/ash shell dialect.
# shellcheck shell=dash
# OpenWrt deletes this file only after exit 0. Every required write/commit is
# checked explicitly: boot sources defaults inside a conditional (set -e is unsafe).
# shellcheck source=/dev/null
. /lib/functions.sh || exit 1

# Apply a group of UCI assignments; return nonzero on the first failed write.
set_options() {
    local assignment
    for assignment in "$@"; do
        uci set "$assignment" || {
            echo "zzz-custom: cannot set $assignment" >&2
            return 1
        }
    done
}

# Remove an obsolete option if present; a failed deletion must remain retryable.
delete_option() {
    if uci -q get "$1" >/dev/null 2>&1; then
        uci -q delete "$1" || return 1
    fi
    return 0
}

set_options 'luci.main.lang=zh_cn' || exit 1
uci commit luci || exit 1

set_options \
    'firewall.@defaults[0].flow_offloading=1' \
    'firewall.@defaults[0].flow_offloading_hw=1' || exit 1
uci commit firewall || exit 1

# A config-preserving sysupgrade can retain the old client and its fw4/ucitrack
# hooks. Detach that manager, but keep its node credentials for manual import.
# Its runtime package is excluded from this firmware; do not execute old init
# scripts against a new rootfs with missing legacy binaries.
if uci -q get 'passwall.@global[0]' >/dev/null 2>&1; then
    set_options \
        'passwall.@global[0].enabled=0' \
        'passwall.@global[0].socks_enabled=0' \
        'passwall.@global[0].acl_enable=0' || exit 1
    uci commit passwall || exit 1
fi
if [ "$(uci -q get firewall.passwall.path)" = /var/etc/passwall.include ]; then
    delete_option firewall.passwall || exit 1
    uci commit firewall || exit 1
fi
if [ -f /etc/config/ucitrack ]; then
    while uci -q get 'ucitrack.@passwall[0]' >/dev/null 2>&1; do
        uci delete 'ucitrack.@passwall[0]' || exit 1
    done
    uci commit ucitrack || exit 1
fi

# Only remove the shipped example endpoint, never a user node reusing its name.
if [ "$(uci -q get passwall2.examplenode.address)" = passwall2.github ] &&
   [ "$(uci -q get passwall2.examplenode.port)" = 1080 ] &&
   [ "$(uci -q get passwall2.examplenode.protocol)" = socks ] &&
   [ "$(uci -q get passwall2.examplenode.type)" = Xray ] &&
   [ "$(uci -q get passwall2.examplenode.remarks)" = Example ]; then
    uci delete passwall2.examplenode || exit 1
fi
# PW1's policy/DNS keys are not PW2 settings, even if copied into its namespace.
for option in dns_mode use_gfw_list chn_list tcp_proxy_mode udp_proxy_mode; do
    delete_option "passwall2.@global[0].$option" || exit 1
done
delete_option 'passwall2.@global_forwarding[0].use_nft' || exit 1

# rulenode is a real PW2 virtual shunt, not an invented proxy server. Preserve
# PW1's private -> GFW -> China -> default precedence and TCP 80/443, UDP-all
# interception scope. Both protocols' unmatched traffic stays direct.
# The user must assign a real outbound to the GFW rule before enabling PW2.
set_options \
    'passwall2.@global[0].enabled=0' \
    'passwall2.@global[0].socks_enabled=0' \
    'passwall2.@global[0].acl_enable=0' \
    'passwall2.@global[0].node=rulenode' \
    'passwall2.@global_forwarding[0].prefer_nft=1' \
    'passwall2.@global_forwarding[0].tcp_redir_ports=80,443' \
    'passwall2.@global_forwarding[0].udp_redir_ports=1:65535' \
    'passwall2.@global[0].remote_dns_protocol=udp' \
    'passwall2.@global[0].remote_dns=127.0.0.1:5335' \
    'passwall2.@global[0].remote_dns_detour=direct' \
    'passwall2.rulenode=nodes' \
    'passwall2.rulenode.remarks=AX6000 GFW' \
    'passwall2.rulenode.type=Xray' \
    'passwall2.rulenode.protocol=_shunt' \
    'passwall2.rulenode.default_node=_direct' \
    'passwall2.rulenode.shunt_group=AX6000' \
    'passwall2.rulenode.ax6000_private=_direct' \
    'passwall2.rulenode.ax6000_cn=_direct' \
    'passwall2.rulenode.ax6000_gfw=_direct' \
    'passwall2.ax6000_private=shunt_rules' \
    'passwall2.ax6000_private.remarks=Private direct' \
    'passwall2.ax6000_private.group=AX6000' \
    'passwall2.ax6000_private.network=tcp,udp' \
    'passwall2.ax6000_private.ip_list=geoip:private' \
    'passwall2.ax6000_gfw=shunt_rules' \
    'passwall2.ax6000_gfw.remarks=GFW proxy - select a real node' \
    'passwall2.ax6000_gfw.group=AX6000' \
    'passwall2.ax6000_gfw.network=tcp,udp' \
    'passwall2.ax6000_gfw.domain_list=geosite:gfw' \
    'passwall2.ax6000_cn=shunt_rules' \
    'passwall2.ax6000_cn.remarks=China direct' \
    'passwall2.ax6000_cn.group=AX6000' \
    'passwall2.ax6000_cn.network=tcp,udp' \
    'passwall2.ax6000_cn.domain_list=geosite:cn' \
    'passwall2.ax6000_cn.ip_list=geoip:cn' || exit 1
uci commit passwall2 || exit 1

# Local upstream for PW2 only. Use direct detour to reach this router's MosDNS,
# not a proxy server's loopback. Leave ordinary dnsmasq/WAN DNS intact while
# PW2 is disabled; MosDNS must not compete for DNS redirection.
set_options \
    'mosdns.config.enabled=1' \
    'mosdns.config.listen_address=127.0.0.1' \
    'mosdns.config.listen_port=5335' \
    'mosdns.config.enable_pipeline=1' \
    'mosdns.config.adblock=1' \
    'mosdns.config.ad_source=geosite.dat' \
    'mosdns.config.redirect=0' \
    'mosdns.config.local_dns_redirect=0' || exit 1
uci commit mosdns || exit 1

# Keep accounting bounded in tmpfs: no frequent NAND writes or unbounded history.
# /var is volatile on OpenWrt; users can export history from the LuCI backup page.
set_options \
    'nlbwmon.@nlbwmon[0].database_directory=/var/lib/nlbwmon' \
    'nlbwmon.@nlbwmon[0].database_generations=3' \
    'nlbwmon.@nlbwmon[0].database_limit=10000' \
    'nlbwmon.@nlbwmon[0].database_compress=1' \
    'nlbwmon.@nlbwmon[0].database_prealloc=0' \
    'nlbwmon.@nlbwmon[0].netlink_buffer_size=524288' \
    'nlbwmon.@nlbwmon[0].commit_interval=24h' \
    'nlbwmon.@nlbwmon[0].refresh_interval=30s' || exit 1
uci commit nlbwmon || exit 1

keep_path=/www/luci-static/argon/background/
touch /etc/sysupgrade.conf || exit 1
if ! grep -Fxq "$keep_path" /etc/sysupgrade.conf; then
    printf '\n%s\n' "$keep_path" >> /etc/sysupgrade.conf || exit 1
fi
exit 0
